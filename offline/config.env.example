# 隐匿对话 设置。复制为 config.env（与 start-lan 同一个文件夹），去掉行首的 # 再改。
# 更新程序不会改动 config.env 和 lan-certs。

# 端口，默认 8443
# PORT=8443

# 额外写进证书的名字或地址，逗号分隔（内网有 DNS 名，或者列出的地址不对时用）
# LAN_NAMES=chat.internal,10.0.5.8

# 每个地址每分钟最多进房几次（默认 60）；总连接数上限（默认 2000）
# JOIN_LIMIT=60
# MAX_CONNECTIONS=2000

# 只在某个地址上监听（默认所有网卡）
# HOST=10.0.5.8

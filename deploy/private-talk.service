# systemd unit for 隐匿对话 without Docker, from the linux offline package
# unpacked to /opt/private-talk. Settings in /opt/private-talk/config.env:
#   PORT=8080  HOST=127.0.0.1  TRUST_PROXY=1   (behind Caddy or nginx)
# See docs/vps.md (install, update.sh to upgrade, --rollback).
[Unit]
Description=隐匿对话 private-talk relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=private-talk
Group=private-talk
WorkingDirectory=/opt/private-talk
Environment=NODE_ENV=production
ExecStart=/opt/private-talk/node/bin/node app/server/server.mjs
Restart=on-failure
RestartSec=3
# The journal gets only the start-up line, warnings and errors: the program
# never prints visitors, addresses, rooms or passphrases.
TimeoutStopSec=10

# Hardening: the relay needs nothing but its own files and the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

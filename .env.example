# 隐匿对话 Docker 部署的设置。./pt setup <域名> 会自动生成 .env；也可以复制本文件为 .env 再改。
# .env 只留在服务器上（含令牌时是机密），不要提交到 Git 或发给别人。

# 你的域名（DNS 已指向这台服务器）
DOMAIN=chat.example.com

# 程序版本，固定到具体版本。升级用 ./pt upgrade，回退用 ./pt rollback。
PT_VERSION=2.15.1

# 隐身入口（可选）：网站只在 https://域名/这个路径/ 下打开，其他地址一律回答普通的 404，
# 扫描的人看不出这台服务器上跑的是什么。8–64 个字母、数字、- 或 _，例如：
# ENTRY_PATH=k7Qp2xVm9aLd

# 用 Cloudflare Tunnel 或 Tailscale 时，改用对应的 compose 文件：
# COMPOSE_FILE=docker-compose.tunnel.yml
# TUNNEL_TOKEN=
# COMPOSE_FILE=docker-compose.tailscale.yml
# TS_AUTHKEY=
# TS_MODE=private

{
  "name": "private-talk",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/ws/*", "/bye"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [{ "name": "JOIN_LIMIT", "namespace_id": "8964", "simple": { "limit": 30, "period": 60 } }],
  "workers_dev": true,
  "observability": { "enabled": false }
}

#!/usr/bin/env bash
# 隐匿对话 Docker 部署的日常操作。在 docker-compose.yml 所在的文件夹运行。
#   ./pt setup <域名>      第一次：把域名和版本写进 .env，启动，自检
#   ./pt status            版本、容器、聊天自检（两个测试客户端互发一条加密消息）
#   ./pt upgrade [版本]    升级到指定版本（默认最新发布）；自检不过就自动回到原版本
#   ./pt rollback          回到升级前的版本
#   ./pt logs              最近的运行日志（只有启动、证书和错误信息，不含访客）
# 设置都在 .env 里（见 .env.example）；docker compose 自己也读它，
# 所以 docker compose ps / logs / restart 等命令照样能直接用。
set -euo pipefail
cd "$(dirname "$0")"
REPO=Freecode100Year/private-talk

say() { printf '%s\n' "$*"; }
die() { printf '✗ %s\n' "$*" >&2; exit 1; }
command -v docker >/dev/null || die "没有安装 Docker：curl -fsSL https://get.docker.com | sh"

# .env helpers: get KEY, put KEY VALUE (keeps the other lines and comments).
get() { [ -f .env ] && sed -n "s/^$1=//p" .env | tail -n1 || true; }
put() {
  touch .env
  if grep -q "^$1=" .env; then sed -i.bak "s|^$1=.*|$1=$2|" .env && rm -f .env.bak; else printf '%s=%s\n' "$1" "$2" >> .env; fi
}
default_version() { sed -n 's/.*private-talk:\${PT_VERSION:-\([0-9][^}]*\)}.*/\1/p' docker-compose.yml | head -n1; }
current() { local v; v=$(get PT_VERSION); printf '%s' "${v:-$(default_version)}"; }
url() { local u; u=$(get PT_URL); [ -n "$u" ] && printf '%s' "$u" || { local d; d=$(get DOMAIN); [ -n "$d" ] && printf 'https://%s' "$d"; }; }

running_version() { docker compose exec -T app node server/health.mjs 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*/\1/p'; }

# The chat check runs inside the app container, against the public address,
# so it goes through DNS, HTTPS and the proxy exactly as a visitor would.
check() {
  local u; u=$(url)
  if [ -z "$u" ]; then say "· 没有 DOMAIN / PT_URL，跳过聊天自检"; return 0; fi
  say "聊天自检 $u …"
  # PT_INSECURE=1 in .env: accept a certificate the system does not trust
  # (a LAN or test setup with its own CA).
  docker compose exec -T app node server/smoke.mjs "$u" ${PT_INSECURE_FLAG:-$( [ "$(get PT_INSECURE)" = 1 ] && printf -- --insecure )}
}

up() { docker compose up -d --wait --wait-timeout 120; }

case "${1:-status}" in
  setup)
    [ -n "${2:-}" ] || die "用法：./pt setup chat.你的域名"
    put DOMAIN "$2"
    [ -n "$(get PT_VERSION)" ] || put PT_VERSION "$(default_version)"
    say "已写入 .env：DOMAIN=$2 PT_VERSION=$(current)"
    up
    say "等待证书（第一次可能要一两分钟）…"
    for _ in $(seq 1 24); do check >/dev/null 2>&1 && break; sleep 5; done
    check && say "✓ 部署完成：$(url)"
    ;;
  status)
    say "设置：$(pwd)/.env  版本：$(current)  上一个版本：$(get PT_PREVIOUS)"
    docker compose ps
    say "正在运行：$(running_version || true)"
    docker compose images app 2>/dev/null | tail -n +2 || true
    check
    ;;
  upgrade)
    target="${2:-}"
    if [ -z "$target" ]; then
      target=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' | head -n1)
      [ -n "$target" ] || die "查不到最新版本，请写明版本：./pt upgrade 2.3.1"
    fi
    target="${target#v}"
    from=$(current)
    [ "$target" != "$from" ] || { say "已经是 $from"; exit 0; }
    say "升级 $from → $target（会断开当前所有聊天，房间和消息不会保留）"
    img="ghcr.io/freecode100year/private-talk:$target"
    # An image loaded with docker load (no internet) is used as it is.
    docker image inspect "$img" >/dev/null 2>&1 || docker pull "$img" >/dev/null || die "拉取镜像失败，版本号对吗？没有改动任何东西。"
    before=$(get PT_PREVIOUS)
    put PT_PREVIOUS "$from"
    put PT_VERSION "$target"
    if up && [ "$(running_version)" = "$target" ] && check; then
      say "✓ 已升级到 $target。有问题用 ./pt rollback 回到 $from。"
    else
      say "✗ $target 自检没通过，正在回到 $from …"
      put PT_VERSION "$from"
      put PT_PREVIOUS "$before"
      up
      check || true
      die "已回到 $from。请把上面的输出和 ./pt logs 的内容发给维护者。"
    fi
    ;;
  rollback)
    prev=$(get PT_PREVIOUS)
    [ -n "$prev" ] || die "没有记录上一个版本。"
    now=$(current)
    put PT_VERSION "$prev"
    put PT_PREVIOUS "$now"
    up
    say "✓ 已回到 $prev（再运行一次 ./pt rollback 回到 $now）"
    check || true
    ;;
  logs)
    docker compose logs --tail 200 "${@:2}"
    ;;
  *)
    sed -n '2,9p' "$0"
    exit 2
    ;;
esac

{
  "name": "private-talk",
  "version": "2.23.0",
  "description": "隐匿对话：匿名、临时、端对端加密的私密聊天室",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "node server/server.mjs",
    "deploy": "node scripts/integrity.mjs && wrangler deploy",
    "integrity": "node scripts/integrity.mjs",
    "verify-site": "node scripts/verify-site.mjs",
    "deploy:freedom8964": "node scripts/deploy-freedom8964.mjs",
    "lan": "node server/lan.mjs",
    "help": "node scripts/build-help.mjs",
    "html-room:generate": "node scripts/build-html-room.mjs",
    "html-room:check": "node scripts/check-html-room.mjs",
    "test:html-room": "node --test test/html-room.test.mjs test/html-room-relay.test.mjs",
    "test:html-room:browser": "node browser-tests/html-room.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  }
}
